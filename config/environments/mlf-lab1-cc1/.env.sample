# -----------------------------------------------------------------------------
# Mojaloop IaC - Environment Variables (sample — CC cluster)
# Copy this file to .env and fill in your values
# -----------------------------------------------------------------------------

# --- Proxmox ---
PROXMOX_VE_ENDPOINT="https://pve.example.com:8006"
PROXMOX_VE_API_TOKEN="user@pam!token_id=your-token-secret"
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-ssh-password"
PROXMOX_VE_INSECURE="true"

# --- AWS --- (route53 DNS)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"

# OCI-REPO credentials (Flux artifact push/pull)
# For GHCR: username = GitHub username, password = PAT with read:packages,write:packages
#   Generate PAT: gh auth refresh -s read:packages,write:packages && gh auth token
# OCI_REPO_USERNAME="your-github-username"
# OCI_REPO_PASSWORD="ghp_xxxxxxxxxxxx"

# OCI-PROXY credentials (optional — container image pull through Harbor)
# Only needed if oci.proxy.active: true and Harbor requires authentication
OCI_PROXY_USERNAME="admin"
OCI_PROXY_PASSWORD="your-harbor-password"

# MinIO root credentials
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="your-minio-password"

# Harbor admin password
HARBOR_ADMIN_PASSWORD="your-harbor-password"

# Observability stack credentials
OBSERVABILITY_MINIO_ACCESS_KEY="observability"
OBSERVABILITY_MINIO_SECRET_KEY="your-observability-s3-password"
GRAFANA_ADMIN_PASSWORD="your-grafana-password"

# SMTP for alert emails (same server as the env clusters' Kratos courier)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
ALERT_EMAIL_FROM="grafana@example.com"
ALERT_EMAIL_TO="ops@example.com"

# Telegram bot for alert messages (create via @BotFather; chat id of the
# group/channel the bot is invited to)
TELEGRAM_BOT_TOKEN="unset"
TELEGRAM_CHAT_ID="0"
