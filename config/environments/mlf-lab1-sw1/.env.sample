# -----------------------------------------------------------------------------
# Mojaloop IaC - Environment Variables (sample — env/switch cluster)
# Copy this file to .env and fill in your values
# -----------------------------------------------------------------------------

# --- Proxmox ---
PROXMOX_VE_ENDPOINT="https://pve.example.com:8006"
PROXMOX_VE_API_TOKEN="user@pam!token_id=your-token-secret"
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-ssh-password"
PROXMOX_VE_INSECURE="true"

# --- AWS --- (route53 DNS)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"

# OCI-REPO credentials (Flux artifact push/pull)
# For GHCR: username = GitHub username, password = PAT with read:packages,write:packages
#   Generate PAT: gh auth refresh -s read:packages,write:packages && gh auth token
OCI_REPO_USERNAME="your-github-username"
OCI_REPO_PASSWORD="ghp_xxxxxxxxxxxx"

# OCI-PROXY credentials (optional — container image pull through Harbor)
# Only needed if oci.proxy.active: true and Harbor requires authentication
OCI_PROXY_USERNAME="admin"
OCI_PROXY_PASSWORD="your-harbor-password"

# MinIO root credentials
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="your-minio-password"

# Harbor admin password
HARBOR_ADMIN_PASSWORD="your-harbor-password"

# --- App Environment Credentials (env clusters only) ---

# MySQL (Percona XtraDB Cluster)
MYSQL_ROOT_PASSWORD="your-mysql-root-password"
MYSQL_CENTRAL_LEDGER_PASSWORD="your-central-ledger-password"
MYSQL_ACCOUNT_LOOKUP_PASSWORD="your-account-lookup-password"
MYSQL_ORACLE_MSISDN_PASSWORD="your-oracle-msisdn-password"

# MongoDB (Percona Server MongoDB)
MONGODB_ROOT_PASSWORD="your-mongodb-root-password"
MONGODB_APP_PASSWORD="your-mongodb-app-password"


# --- Auth Layer Credentials (env clusters only) ---

# Auth DB (Hydra, Kratos, Keto, MCM database users)
HYDRA_DB_PASSWORD="your-hydra-db-password"
KRATOS_DB_PASSWORD="your-kratos-db-password"
KETO_DB_PASSWORD="your-keto-db-password"
MCM_DB_PASSWORD="your-mcm-db-password"

# Keycloak admin
KEYCLOAK_ADMIN_PASSWORD="your-keycloak-admin-password"

# OIDC client secrets
HUBOP_OIDC_SECRET="your-finance-portal-oidc-secret"
MCM_OIDC_CLIENT_SECRET="your-mcm-oidc-secret"
ROLE_ASSIGN_SVC_SECRET="your-role-assign-svc-secret"
DFSP_OIDC_CLIENT_SECRET="your-dfsp-oidc-secret"

# Hub operator admin (seeded into Kratos on first deploy)
HUB_ADMIN_PASSWORD="your-hub-admin-password"
HUB_ADMIN_EMAIL="hub-admin@example.com"


# --- Hub Identity (env clusters only) ---
# Canonical hub participant name. Drives HUB_PARTICIPANT.NAME on switch services,
# SWITCH_ID on MCM, and HUB_NAME for DFSP onboarding. Must equal the string the
# switch uses as fspiop-source on outbound callbacks.
HUB_PARTICIPANT_NAME="Hub"

# --- DFSP Onboarding Parameters (env clusters only) ---
# TTK-based DFSP provisioning: create participant, set limits, fund settlement, register endpoints.
# These have sensible defaults — only override if your deployment uses different values.
# Initial deposit into DFSP settlement account (determines available liquidity for transfers)
ONBOARDING_FUNDS_IN="1000000"
# Maximum net debit position — transfers are blocked when DFSP exceeds this limit
ONBOARDING_NET_DEBIT_CAP="500000"
# TTK test-cases collection version (from github.com/mojaloop/testing-toolkit-test-cases)
ONBOARDING_COLLECTION_VERSION="17.0.4"


# --- Backup S3 Credentials (env clusters only) ---
# S3-compatible storage for MySQL/MongoDB backups (CC MinIO or cloud S3)
# S3 endpoint, bucket, and region are configured in config.yaml (backup.s3 section)
BACKUP_S3_ACCESS_KEY="your-backup-s3-access-key"
BACKUP_S3_SECRET_KEY="your-backup-s3-secret-key"


# --- SMTP Credentials (env clusters only) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
