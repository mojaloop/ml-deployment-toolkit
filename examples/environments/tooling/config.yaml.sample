# yaml-language-server: $schema=../../config/schemas/environment.schema.json
# ------------------------------------------------------------------
# Environment config (sample — Tooling Cluster)
# Copy this file to config.yaml and edit for your environment.
# Secrets live in .env next to this file (sourced via Makefile) —
# never put credentials here.
# ------------------------------------------------------------------
version: 1

cluster:
  name: "my-cc"
  role: "tooling"                          # tooling | hub | bare
  vip: "192.168.0.210"                # Kubernetes API floating IP (on-prem only)
  lb_ipam:
    pools:                            # one single-IP pool per gateway; optional wan = border-DNAT outside IP
      gw-int:
        lan: "192.168.0.211"
      gw-ext:
        lan: "192.168.0.212"

# Deployment template — config/templates/{role}/{template}.yaml
template: "medium"

infra:
  provider: "proxmox"                 # proxmox | aws | digitalocean
  proxmox:
    # Maps template placement groups -> Proxmox physical nodes
    placement:
      pg-1: "pve-node-1"
      # pg-2: "pve-node-2"
      # pg-3: "pve-node-3"
    network_bridge: "vmbr0"
    storage:
      disks: "local-lvm"
      images: "local"
      snippets: "local"
  # Talos node OS overrides (optional — any on-prem provider)
  talos:
    nameservers:
      - "8.8.8.8"
      - "1.1.1.1"
    ntp_servers:
      - "time.cloudflare.com"

# Credentials in .env: DIGITALOCEAN_TOKEN, CLOUDFLARE_API_TOKEN,
# or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_REGION for route53.
dns:
  provider: "route53"                 # digitalocean | cloudflare | route53
  domain: "cc1.lab1.example.com"

# Certificates (ACME). email is the ACME account contact.
cert:
  email: "ops@example.com"
  # The directory URL selects the CA. Any CA other than Let's Encrypt also needs
  # ACME_EAB_* in .env — see doc/adopter/deploy/configuration.md
  server: "https://acme-v02.api.letsencrypt.org/directory"

# Distribution gitops artifact consumed by Flux (credentials OCI_REPO_* in .env)
artifact:
  url: "oci://ghcr.io/your-org/ml-deployment-toolkit"
  version: "v0.19.0"                  # OCI tag — must be a pinned version; "latest" is disallowed

# Container image pull-through cache (none on the Tooling Cluster itself — Harbor lives here).
# robots: pull-only Harbor accounts for consuming Hubs. Each Hub authenticates
# as robot-<name>; the secret comes from `make secrets`. Convention: one robot
# per Hub, named after the Hub's cluster.name. Creation only — removing an
# entry stops managing the robot but never deletes it.
registry:
  enabled: false
  # robots is independent of enabled — this cluster serves the mirror rather
  # than consuming one.
  # robots:
  #   - name: "my-switch"

# Backup target. This cluster serves MinIO rather than backing itself up to
# one, so enabled is false — it is a switch, never inferred from a missing
# endpoint. buckets is independent of it: extra buckets to serve on top of the
# system buckets (harbor, backups, thanos, loki, tempo). Each gets a generated
# user scoped to that one bucket — the access key is the bucket name, the
# secret key comes from `make secrets`. Convention: one bucket per Hub, named
# <hub cluster.name>-backups. Creation only — removing an entry stops managing
# the bucket but never deletes data.
object_storage:
  enabled: false
  # buckets:
  #   - name: "my-switch-backups"

# Telemetry push sink — this cluster is the sink, so it ships nowhere else.
observability:
  enabled: false

# Transactional email (SMTP). Credentials SMTP_USER/SMTP_PASSWORD in .env.
email:
  host: "smtp.example.com"
  port: "587"
  from: "grafana@example.com"

# Alert delivery channels (Grafana contact points)
alerting:
  email:
    to: "ops@example.com"
  telegram:                           # token in .env (TELEGRAM_BOT_TOKEN)
    chat_id: "0"
