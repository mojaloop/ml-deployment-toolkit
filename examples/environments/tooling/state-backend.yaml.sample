# yaml-language-server: $schema=../../../config/schemas/state-backend.schema.json
# Terraform state backend (rename to state-backend.yaml to activate; absent =
# local state under artifacts/<env>/state/ — then back it up out of band).
# The tooling environment CANNOT store state in the MinIO it creates (the
# bucket would not exist until the state it stores is applied): use external
# S3 — a real AWS bucket (endpoint omitted) or any third-party S3-compatible
# service — or stay local with a mandatory backup. State carries every
# platform secret in plaintext: private + versioned bucket, and put
# STATE_S3_ACCESS_KEY / STATE_S3_SECRET_KEY in .env.
version: 1
type: s3
s3:
  # endpoint omitted = real AWS S3 (region selects the endpoint); set it for
  # any other S3-compatible service.
  bucket: "MY_ORG-dtk-tooling-tf-state"
  region: "eu-west-1"
  key_prefix: "MY_ENV"
  use_lockfile: true
