# -----------------------------------------------------------------------------
# External credentials only (sample — Tooling Cluster). Copy to .env and fill in.
# Internal service passwords (MinIO, Harbor, Grafana, ...) are generated by
# Terraform; retrieve with: make secrets ENV=<your-env>
# -----------------------------------------------------------------------------

# --- Proxmox (native provider env vars) ---
PROXMOX_VE_ENDPOINT="https://pve.example.com:8006"
PROXMOX_VE_API_TOKEN="user@pam!token_id=your-token-secret"
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-ssh-password"

# --- DNS provider credential (dns.provider) ---
# digitalocean: DIGITALOCEAN_TOKEN / cloudflare: CLOUDFLARE_API_TOKEN /
# route53: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"

# --- ACME External Account Binding (only when cert.server is not Let's Encrypt) ---
# Every public CA except Let's Encrypt requires EAB. Obtain the pair from the CA:
#   Google Trust Services: gcloud publicca external-account-keys create
#   ZeroSSL: REST API /acme/eab-credentials  /  SSL.com: web dashboard
# Paste the HMAC key EXACTLY as the CA gives it — it is already base64url and
# re-encoding it causes "Invalid MAC on JWS request" at issuance. Set both or
# neither; a half-configured pair fails at plan time.
# ACME_EAB_KEY_ID="your-eab-key-id"
# ACME_EAB_HMAC_ENCODED="your-eab-hmac-key"

# --- OCI artifact registry (Flux pull + make push-gitops) ---
# For GHCR: username = GitHub username, password = PAT with read:packages,write:packages
#   Generate PAT: gh auth refresh -s read:packages,write:packages && gh auth token
OCI_REPO_USERNAME="your-github-username"
OCI_REPO_PASSWORD="ghp_xxxxxxxxxxxx"

# --- Telemetry-ingest basic auth (obs-ingest front on gw-ext) ---
# ONE pair shared across clusters: this Tooling Cluster serves the
# authenticated ingest endpoints (thanos/loki/tempo .ext) with it, and every
# env/switch cluster pushing telemetry here sets the SAME values in its .env.
# Pick a strong password, e.g.: openssl rand -hex 24
OBS_INGEST_USERNAME="obs-ingest"
OBS_INGEST_PASSWORD="your-obs-ingest-password"

# --- SMTP credentials (email capability) ---
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"

# --- Telegram bot token (alerting capability — create via @BotFather) ---
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
