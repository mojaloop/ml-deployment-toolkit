# -----------------------------------------------------------------------------
# External credentials only (sample — env/switch cluster). Copy to .env and
# fill in. Internal service passwords (DBs, hub admin, OIDC clients, ...) are
# generated by Terraform; retrieve with: make secrets ENV=<your-env>
# -----------------------------------------------------------------------------

# --- Proxmox (native provider env vars) ---
PROXMOX_VE_ENDPOINT="https://pve.example.com:8006"
PROXMOX_VE_API_TOKEN="user@pam!token_id=your-token-secret"
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-ssh-password"

# --- DNS provider credential (dns.provider) ---
# digitalocean: DIGITALOCEAN_TOKEN / cloudflare: CLOUDFLARE_API_TOKEN /
# route53: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"

# --- ACME External Account Binding (only when cert.server is not Let's Encrypt) ---
# Every public CA except Let's Encrypt requires EAB. Obtain the pair from the CA:
#   Google Trust Services: gcloud publicca external-account-keys create
#   ZeroSSL: REST API /acme/eab-credentials  /  SSL.com: web dashboard
# Paste the HMAC key EXACTLY as the CA gives it — it is already base64url and
# re-encoding it causes "Invalid MAC on JWS request" at issuance. Set both or
# neither; a half-configured pair fails at plan time.
# ACME_EAB_KEY_ID="your-eab-key-id"
# ACME_EAB_HMAC_ENCODED="your-eab-hmac-key"

# --- OCI artifact registry (Flux pull + make push-gitops) ---
# For GHCR: username = GitHub username, password = PAT with read:packages,write:packages
#   Generate PAT: gh auth refresh -s read:packages,write:packages && gh auth token
OCI_REPO_USERNAME="your-github-username"
OCI_REPO_PASSWORD="ghp_xxxxxxxxxxxx"

# --- Registry proxy (Tooling Cluster Harbor) — filled after Tooling Cluster deploy.
# Username = robot-<name> for the robot declared on the Tooling Cluster under
# registry.robots; make secrets ENV=<your-cc-env> -> harbor_robot_<name>_secret
OCI_PROXY_USERNAME="robot-my-switch"
OCI_PROXY_PASSWORD="your-harbor-robot-secret"

# --- Backup S3 (Tooling Cluster MinIO) — filled after Tooling Cluster deploy.
# Access key = the bucket declared on the Tooling Cluster under object_storage.buckets;
#     make secrets ENV=<your-cc-env>  ->  minio_bucket_<name>_secret_key
BACKUP_S3_ACCESS_KEY="my-switch-backups"
BACKUP_S3_SECRET_KEY="your-minio-bucket-secret-key"

# --- Telemetry-ingest basic auth (push to the Tooling Cluster) ---
# MUST match the Tooling Cluster's OBS_INGEST_* pair — Alloy/k6 authenticate
# their telemetry push (observability.*_url) with these. For a third-party
# sink (e.g. Grafana Cloud) set that sink's credentials instead.
OBS_INGEST_USERNAME="obs-ingest"
OBS_INGEST_PASSWORD="your-obs-ingest-password"

# --- External MySQL (only when data.mysql.mode: external-unmanaged) ---
# MYSQL_ROOT_PASSWORD="your-mysql-root-password"

# --- SMTP credentials (email capability — Kratos courier) ---
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"

# --- Telegram bot token (alerting capability — create via @BotFather) ---
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
