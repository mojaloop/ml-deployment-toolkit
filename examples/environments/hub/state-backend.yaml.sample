# yaml-language-server: $schema=../../../config/schemas/state-backend.schema.json
# Terraform state backend (rename to state-backend.yaml to activate; absent =
# local state under artifacts/<env>/state/ — then back it up out of band).
# Hub environments use the tooling MinIO (same trust domain as backups).
# State carries every platform secret in plaintext: private + versioned bucket.
# Declare the bucket via the tooling env's object_storage.buckets (access key =
# bucket name, `make secrets` prints the secret key), put STATE_S3_ACCESS_KEY /
# STATE_S3_SECRET_KEY in .env, then migrate the existing state with
#   CONFIRM=yes tools/migrate-state-backend.sh <env>
version: 1
type: s3
s3:
  endpoint: "https://s3.int.TOOLING_DOMAIN"
  bucket: "MY_ENV-tf-state"
  region: "us-east-1"
  key_prefix: "MY_ENV"
  use_lockfile: true
