# yaml-language-server: $schema=../../config/schemas/environment.schema.json
# ------------------------------------------------------------------
# Environment config (sample — env/switch cluster, backed by a CC)
# Copy this file to config.yaml and edit for your environment.
# Secrets live in .env next to this file (sourced via Makefile) —
# never put credentials here.
# ------------------------------------------------------------------
version: 1

cluster:
  name: "my-switch"
  role: "env"                         # cc | env | base
  vip: "192.168.0.214"                # Kubernetes API floating IP (on-prem only)
  lb_ipam:
    range: "192.168.0.215-192.168.0.217"

# Deployment template — config/templates/{role}/{template}.yaml
template: "tps-10"

infra:
  provider: "proxmox"                 # proxmox | aws | digitalocean
  proxmox:
    # Maps template placement groups -> Proxmox physical nodes
    placement:
      pg-1: "pve-node-1"
      pg-2: "pve-node-2"
      pg-3: "pve-node-3"
    network_bridge: "vmbr0"
    storage:
      disks: "local-lvm"
      images: "local"
      snippets: "local"
  # Talos node OS overrides (optional — any on-prem provider)
  talos:
    nameservers:
      - "8.8.8.8"
      - "1.1.1.1"
    ntp_servers:
      - "time.cloudflare.com"

# Credentials in .env: DIGITALOCEAN_TOKEN, CLOUDFLARE_API_TOKEN,
# or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_REGION for route53.
dns:
  provider: "route53"                 # digitalocean | cloudflare | route53
  domain: "sw1.lab1.example.com"

# Certificates (ACME). email is the ACME account contact.
cert:
  provider: "acme"
  email: "ops@example.com"

# Distribution gitops artifact consumed by Flux (credentials OCI_REPO_* in .env)
artifact:
  url: "oci://ghcr.io/your-org/ml-deployment-toolkit"
  version: "latest"                   # OCI tag — "latest" or pin to a version

# One value drives every toolkit-cc preset below: the Tooling Cluster's domain.
toolkit_cc:
  domain: "cc1.lab1.example.com"

# Image pull-through cache via the CC's Harbor (credentials OCI_PROXY_* in .env)
registry:
  provider: "toolkit-cc"              # derives harbor.int.<toolkit_cc.domain>

# Backup target (credentials BACKUP_S3_ACCESS_KEY/SECRET_KEY in .env)
object_storage:
  provider: "toolkit-cc"              # derives https://s3.int.<toolkit_cc.domain>
  bucket: "backups"

# Telemetry push sink
observability:
  provider: "toolkit-cc"              # derives loki/thanos/tempo push URLs

# Data layer — per-store mode: in-cluster-managed | external-unmanaged
# (external-managed is schema-reserved, not yet implemented)
data:
  mysql:
    mode: "in-cluster-managed"
  # External MySQL instead (credentials in .env):
  # mysql:
  #   mode: "external-unmanaged"
  #   host: "mysql.lab1.example.com"
  #   port: "3306"
  kafka:
    mode: "in-cluster-managed"
  mongodb:
    mode: "in-cluster-managed"
  redis:
    mode: "in-cluster-managed"

# Transactional email (SMTP — Kratos courier). Credentials in .env.
email:
  host: "smtp.example.com"
  port: "587"
  from: "grafana@example.com"

# Alert delivery channels (Grafana contact points)
alerting:
  email:
    to: "ops@example.com"
  telegram:                           # token in .env (TELEGRAM_BOT_TOKEN)
    chat_id: "0"

app:
  # fspiop | iso20022 — set once at deploy time; switching mid-flight breaks
  # in-progress transfers. DFSPs and simulators connecting to the switch must
  # use the same dialect.
  api_type: "fspiop"
  hub:
    participant_name: "Hub"
    admin_email: "hub-admin@example.com"
    onboarding:
      # Initial deposit into DFSP settlement accounts (available liquidity)
      funds_in: "1000000"
      # Maximum net debit position — transfers blocked beyond this limit
      net_debit_cap: "500000"
