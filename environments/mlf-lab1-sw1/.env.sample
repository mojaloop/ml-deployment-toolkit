# -----------------------------------------------------------------------------
# External credentials only (sample — env/switch cluster). Copy to .env and
# fill in. Internal service passwords (DBs, hub admin, OIDC clients, ...) are
# generated by Terraform; retrieve with: make secrets ENV=<your-env>
# -----------------------------------------------------------------------------

# --- Proxmox (native provider env vars) ---
PROXMOX_VE_ENDPOINT="https://pve.example.com:8006"
PROXMOX_VE_API_TOKEN="user@pam!token_id=your-token-secret"
PROXMOX_VE_SSH_USERNAME="root"
PROXMOX_VE_SSH_PASSWORD="your-ssh-password"

# --- DNS provider credential (dns.provider) ---
# digitalocean: DIGITALOCEAN_TOKEN / cloudflare: CLOUDFLARE_API_TOKEN /
# route53: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"

# --- OCI artifact registry (Flux pull + make push-gitops) ---
# For GHCR: username = GitHub username, password = PAT with read:packages,write:packages
#   Generate PAT: gh auth refresh -s read:packages,write:packages && gh auth token
OCI_REPO_USERNAME="your-github-username"
OCI_REPO_PASSWORD="ghp_xxxxxxxxxxxx"

# --- Registry proxy (toolkit-cc Harbor) — filled after CC deploy:
#     make secrets ENV=<your-cc-env>  ->  harbor_admin_password
OCI_PROXY_USERNAME="admin"
OCI_PROXY_PASSWORD="your-harbor-password"

# --- Backup S3 (toolkit-cc MinIO) — filled after CC deploy:
#     make secrets ENV=<your-cc-env>  ->  minio_root_password
BACKUP_S3_ACCESS_KEY="minioadmin"
BACKUP_S3_SECRET_KEY="your-minio-password"

# --- External MySQL (only when data.mysql.mode: external-unmanaged) ---
# MYSQL_ROOT_PASSWORD="your-mysql-root-password"

# --- SMTP credentials (email capability — Kratos courier) ---
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"

# --- Telegram bot token (alerting capability — create via @BotFather) ---
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
